# Copy to .env and fill in the keys you have. Never commit .env.
# The CLIs read the nearest .env (searched upward from the current directory); .env wins over shell exports.

# Model providers: set the ones whose registry entries you use (packages/agentkit-core/.../models.yaml).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
FIREWORKS_API_KEY=

# Optional web search keys. `web_search` (backend: auto) uses each one that is set, in this order,
# falling back to the next on error and finally to keyless DuckDuckGo (often blocked/rate-limited).
PARALLEL_API_KEY=
BRAVE_API_KEY=
TAVILY_API_KEY=

# Note: the shipped research agent (apps/research_agent/agent.yaml) sets `selection: decisions`, which calls the OpenAI
# Decisions API, so OPENAI_API_KEY is needed even when the agent itself runs on another provider.

# --- Optional platform settings (Phase 0b). All are off/defaulted when unset; uncomment to use. ---
# Leave these commented in .env when you use per-tenant stamps (make stamp TENANT=<t>): the stamp's
# deploy/tenants/<t>.env supplies them, and a value here would override every stamp
# (.env wins over the process env).

# The one tenant this deployment serves (default "default"); runs for another tenant are refused.
# AGENTKIT_TENANT=default

# Persistence, needed only for --persist: Postgres URL and a 16/24/32-character AES key.
# DATABASE_URL=postgresql://agentkit:agentkit@127.0.0.1:55432/agentkit
# LANGGRAPH_AES_KEY=
# PG_CONNECT_TIMEOUT_SECONDS=10

# Tracing: off unless set. Spans go only to this OTLP/HTTP collector.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# 1 keeps prompt/completion and error text in spans (masked by default).
# AGENTKIT_TRACE_PAYLOADS=0

# --- Knowledge-base agent (apps/kb_agent; setup in deploy/README.md "Knowledge base"). ---
# At agent run time BOTH are kb_reader DSNs (read-only role created by `agentkit-kb setup`):
# KB_DATABASE_URL feeds kb_search (connector kb-docs), KB_READER_DATABASE_URL feeds sql_query (kb-sql).
# The admin DSN is never put here: pass it on the command line to `agentkit-kb setup/ingest`
# (`make kb-ingest KB_ADMIN_DATABASE_URL=...`). KB_READER_PASSWORD is the password setup gives kb_reader.
# KB_READER_PASSWORD=
# KB_READER_DATABASE_URL=postgresql://kb_reader:<KB_READER_PASSWORD>@127.0.0.1:<pg port>/agentkit
# KB_DATABASE_URL=postgresql://kb_reader:<KB_READER_PASSWORD>@127.0.0.1:<pg port>/agentkit
