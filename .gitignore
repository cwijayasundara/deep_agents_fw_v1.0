.env
.venv/
__pycache__/
*.pyc
.DS_Store
.pytest_cache/

# Raw live-run logs stay local; summaries (md/json) are committed
evidence/**/*.log
evidence/**/*.stdout
evidence/**/status.txt

# Local trace collector output (deploy/compose.dev.yaml, profile tracing)
deploy/otel-out/

# Per-tenant stamps: real tenant env files hold AES keys (only example.env is committed)
deploy/tenants/*.env
!deploy/tenants/example.env

# Default research / research-eval CLI outputs at the repo root
/report.md
/eval_results.*

# verify-agentkit skill runs: reports, transcripts, trace and ledger copies stay local
evidence/verify/
