# One tenant's deployment settings. scripts/stamp_tenant.sh <tenant> writes
# deploy/tenants/<tenant>.env in this shape the first time (fresh AES key, password and free ports)
# and never rewrites it. Real tenant files are git-ignored: they hold the tenant's AES key.
# Losing LANGGRAPH_AES_KEY makes the tenant's threads and memories unreadable; back it up.

AGENTKIT_TENANT=example
# Host ports (127.0.0.1 only); every tenant gets its own pair.
AGENTKIT_PG_PORT=55501
AGENTKIT_OTLP_PORT=55502
AGENTKIT_PG_PASSWORD=change-me-generated-by-stamp
DATABASE_URL=postgresql://agentkit:change-me-generated-by-stamp@127.0.0.1:55501/agentkit
# 16, 24 or 32 characters; stamp_tenant.sh generates 32.
LANGGRAPH_AES_KEY=change-me-generated-by-stamp-32c
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:55502
# Tool side-effect classes this tenant's agents may call: any of read, write, external.
# The tool guards refuse the rest; `write` is off unless listed. Missing line = read,external.
AGENTKIT_ALLOWED_SIDE_EFFECTS=read,external

# Optional: forward this tenant's spans to its own Langfuse project (the JSONL file is always
# written). Set all three, then re-run `make stamp TENANT=<tenant>`.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
